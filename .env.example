# ═══════════════════════════════════════════════════════════════════════
# Loyalty Program — Multi-Tenant SaaS Platform Environment Config
# ═══════════════════════════════════════════════════════════════════════

# Core Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MongoDB connection string with optional replicaSet)
MONGO_URI=mongodb://127.0.0.1:27017/loyalty_saas

# JWT Authentication Secrets & Lifespans
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=90

# Rate Limiting (Requests per window per tenant/IP)
RATE_LIMIT_MAX=200
RATE_LIMIT_TIMEWINDOW=60000

# Email Service (SMTP or Resend API)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
MY_EMAIL_USERNAME=support@loyaltyplatform.io
MY_EMAIL_PASSWORD=your_app_password_here
RESEND_API_KEY=

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
